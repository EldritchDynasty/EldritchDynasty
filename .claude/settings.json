{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run setup:*)",
      "Bash(npm run setup)",
      "Bash(npm run doctor:*)",
      "Bash(npm run doctor)",
      "Bash(npm run check:*)",
      "Bash(npm run check)",
      "Bash(npm run land:*)",
      "Bash(npm run land)",
      "Bash(npm run verdict:*)",
      "Bash(npm run verdict)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run validate:*)",
      "Bash(npm run validate)",
      "Bash(npm test:*)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm run gate:*)",
      "Bash(npm run gate)",
      "Bash(npm run gates:*)",
      "Bash(npm run gates)",
      "Bash(npm run digest:*)",
      "Bash(npm run digest)",
      "Bash(npm run harness:*)",
      "Bash(npm run harness)",
      "Bash(npm run lint:prose:*)",
      "Bash(npm run lint:prose)",
      "Bash(npm run gen:docs:*)",
      "Bash(npm run gen:docs)",
      "Bash(npm run gen:loci:*)",
      "Bash(npm run gen:loci)",
      "Bash(npm run smoke:*)",
      "Bash(npm run smoke)",
      "Bash(npm run mutate)",
      "Bash(npm run mutate:*)",
      "Bash(npm run corpus)",
      "Bash(npm run corpus:*)",
      "Bash(npm run cost)",
      "Bash(npm run cost:*)",
      "Bash(npm run scoreboard)",
      "Bash(npm run scoreboard:*)",
      "Bash(npm run agents:*)",
      "Bash(npm run agents)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git ls-remote:*)"
    ]
  },
  "//hooks": [
    "EXEC FORM, AND NOT SHELL FORM, BECAUSE OF WINDOWS.",
    "A hook whose `command` is one string is handed to a shell — sh -c on macOS and Linux,",
    "Git Bash on Windows, PowerShell when Git Bash is not installed. Three shells, three",
    "different answers about how $CLAUDE_PROJECT_DIR expands and how a path is quoted, and a",
    "hook that fails to start reports nothing an agent ever sees. Naming `command` and `args`",
    "separately skips the shell entirely: Claude Code resolves `node` on PATH, substitutes",
    "${CLAUDE_PROJECT_DIR} into each argument as a plain string, and spawns it directly.",
    "`node` is the command rather than the script because Windows exec form needs a real",
    "executable — which is also why every hook here is .mjs and none of them is .sh."
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"],
            "timeout": 300,
            "statusMessage": "Orienting, installing dependencies and warming the content cache…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edit.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-content.mjs"],
            "timeout": 60,
            "statusMessage": "Validating content…"
          }
        ]
      }
    ]
  }
}
