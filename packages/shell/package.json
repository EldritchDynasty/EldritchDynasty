{
  "name": "@ed/shell",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Eldritch Dynasty. Owns the window and the disk; owns no rules.",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mod-editor": "node scripts/dev.mjs --mod-editor",
    "start": "node scripts/electron.mjs .",
    "preview": "npm run build --workspace @ed/client && node scripts/electron.mjs .",
    "smoke": "node scripts/electron.mjs . --smoke",
    "dist:windows": "node scripts/dist-windows.mjs",
    "dist:mod-editor": "node scripts/dist-windows.mjs --mod-editor"
  },
  "devDependencies": {
    "@ed/content": "*",
    "@ed/core": "*",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  }
}
